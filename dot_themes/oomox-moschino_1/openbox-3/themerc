# Menu
menu.border.color: #0e0021

menu.title.bg: Solid Flat
menu.title.bg.color: #211821
menu.title.bg.shadow: 0
menu.title.text.color: #e7e2ea
menu.title.text.justify: Center

menu.items.bg: Solid Flat
menu.items.bg.color: #211821
menu.items.text.color: #e7e2ea
menu.items.disabled.text.color: #b5afb7

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #d3241d
menu.items.active.text.color: #e7e2ea

menu.separator.color: #b5afb7
menu.separator.width: 1
menu.separator.padding.width: 2
menu.separator.padding.height: 4

# Window focused
window.active.title.separator.color: #211821

# Active window
window.active.border.color: #d3241d


window.active.title.bg: flat solid
window.active.title.bg.color: #211821
window.active.title.separator.color: #211821
window.active.text.justify: center

window.active.label.bg: parentrelative
window.active.label.text.color: #e7e2ea

window.active.handle.bg: flat solid
window.active.handle.bg.color: #211821

window.active.grip.bg: flat solid
window.active.grip.bg.color: #211821

window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #211821
window.active.button.unpressed.image.color: #e7e2ea

window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #d3241d
window.active.button.pressed.image.color: #eae8f3

window.active.button.disabled.bg: flat solid
window.active.button.disabled.bg.color: #211821
window.active.button.disabled.image.color: #b5afb7

window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #211821
window.active.button.hover.image.color: #d3241d

#window.active.button.toggled.bg: #d3241d
#window.active.button.toggled.image.color: #eae8f3

# Inactive window
window.inactive.border.color: #211821

window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #211821
window.inactive.title.separator.color: #211821
window.inactive.text.justify: center

window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #b5afb7

window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #211821

window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #211821

window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #211821
window.inactive.button.unpressed.image.color: #b5afb7

window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #d3241d
window.inactive.button.pressed.image.color: #eae8f3

window.inactive.button.disabled.bg: flat solid
window.inactive.button.disabled.bg.color: #b5afb7
window.inactive.button.disabled.image.color: #211821

window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #211821
window.inactive.button.hover.image.color: #d3241d


# OSD
osd.border.width: 1
osd.border.color: #d3241d

osd.bg: flat solid
osd.bg.color: #211821
osd.label.bg: flat solid
osd.label.bg.color: #211821
osd.label.text.color: #e7e2ea

# OSD
osd.bg: Solid Flat
osd.bg.color: #211821
osd.bg.shadow: 0

osd.border.width: 2
osd.hilight.bg: Solid Flat
osd.hilight.bg.color: #d3241d
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #e7e2ea

osd.button.unpressed.bg: flat border
osd.button.unpressed.bg.color: #d5da85
#osd.button.unpressed.*.border.color: #1c1c2b

osd.button.pressed.bg: flat border
osd.button.pressed.bg.color: #d3241d
#osd.button.pressed.*.border.color: #eae8f3

osd.button.focused.bg: flat solid border
osd.button.focused.bg.color: #0e0021
#osd.button.focused.*.border.color: #e7e2ea

osd.button.focused.box.color: #d3241d


# Fonts
window.active.label.text.font:shadow=n
window.inactive.label.text.font:shadow=n
menu.items.font:shadow=n
menu.title.text.font:shadow=n


# Everything else
border.width: 3
padding.width: 8
padding.height: 3
window.handle.width: 0
window.client.padding.width: 0
window.label.text.justify: center
#menu.overlap: 0
